// ─── Types ────────────────────────────────────────────────────────────────────

interface GymExercise {
  id: string;
  dayId: string;
  name: string;
  sets: number;
  reps: number;
  weight: number;
  restTime: number;
  duration: number;
  notes: string;
}

interface GymDay {
  id: string;
  name: string;
  createdAt: number;
}

interface GymWeekSchedule {
  [dayOfWeek: number]: string; // dayOfWeek (0=Mon) -> gymDayId
}

interface CompletedSet {
  exerciseId: string;
  setIndex: number;
  reps: number;
  weight: number;
}

interface GymSession {
  id: string;
  date: string; // YYYY-MM-DD
  gymDayId: string;
  gymDayName: string;
  completedSets: CompletedSet[];
  timestamp: number;
}

type GymView = "schedule" | "workout" | "stats";

// ─── Storage helpers ──────────────────────────────────────────────────────────

const KEYS = {
  days: "sha_gym_days",
  exercises: "sha_gym_exercises",
  schedule: "sha_gym_week_schedule",
  sessions: "sha_gym_sessions",
  weekStart: "sha_gym_week_start",
};

function load<T>(key: string, fallback: T): T {
  try {
    const v = localStorage.getItem(key);
    return v ? (JSON.parse(v) as T) : fallback;
  } catch {
    return fallback;
  }
}

function save(key: string, value: unknown) {
  localStorage.setItem(key, JSON.stringify(value));
}

function todayStr() {
  return new Date().toISOString().split("T")[0];
}

function uid() {
  return `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;
}

const DAY_NAMES = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

